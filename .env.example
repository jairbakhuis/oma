# --- Letta (her own account, free tier) ---
LETTA_API_KEY=lt-...

# The agent ID printed by `npm run create-agent`
OMA_AGENT_ID=agent-...

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456:ABC...

# Only her chat may talk to the bot (from @userinfobot)
OMA_TELEGRAM_CHAT_ID=123456789

# Optional: which environment/computer the agent's tools run on.
# Leave empty to let the SDK pick the default online computer.
OMA_COMPUTER=
